# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL and anon key. Both reach the browser by design; the anon key is
# constrained by Row Level Security to approved observations only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. The service role key bypasses RLS entirely - it must never appear in a
# NEXT_PUBLIC_ variable or be imported by a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron presents as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Shared secret for the review UI and every mutation endpoint.
ADMIN_SECRET=

# --- Optional tuning. Defaults live in lib/config.ts. -------------------------

# MAX_REPORTS_PER_RUN=3
# EXTRACTION_CONFIDENCE_MIN=0.6
# SUSPICIOUS_CHANGE_RATIO=0.6
# MIN_PRICE_KHR=100
# MAX_PRICE_KHR=500000
# SCRAPER_USER_AGENT=
